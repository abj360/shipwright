# LLM (set the key for whichever provider SHIPWRIGHT_PROVIDER selects)
SHIPWRIGHT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub
GITHUB_TOKEN=
WEBHOOK_SECRET=dev-secret
REPO_URL=https://github.com/org/repo

# Gateway
PORT=4000
GATEWAY_TOKEN=dev-token
UI_PORT=5173
WORK_DIR=/tmp/shipwright-work
BASE_BRANCH=main

# Agent
AGENT_URL=http://agent:8000
JUDGELINE_URL=http://localhost:7700
JUDGELINE_THRESHOLD=0.75

# Sandbox (cgroup v2 ceilings)
SHIPWRIGHT_SANDBOX_CPU=100000
SHIPWRIGHT_SANDBOX_MEM=536870912
SHIPWRIGHT_SANDBOX_PIDS=256
SHIPWRIGHT_INTEGRATION=0
SHIPWRIGHT_DEFAULT_BRANCH=main
SHIPWRIGHT_CACHE_DIR=.shipwright
SHIPWRIGHT_RUN_TIMEOUT_S=3600
SHIPWRIGHT_MAX_PARALLEL_RUNS=4
SHIPWRIGHT_DEBUG=0

# Logging
LOG_LEVEL=info
SHIPWRIGHT_TELEMETRY=0
SHIPWRIGHT_LOG_JSON=0
SHIPWRIGHT_GIT_DEPTH=1

# Red-team suite
RED_TEAM_ENABLED=0
